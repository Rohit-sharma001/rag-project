# --- LLM (required for answer generation) ---
OPENAI_API_KEY=gsk-your-key-here
LLM_MODEL=groq

# --- Embeddings ---
# "huggingface" runs fully local/free (sentence-transformers, no API key needed)
# "openai" uses OpenAI's embedding API instead
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Storage / data ---
CHROMA_PERSIST_DIR=./chroma_store
DATA_DIR=../data

# --- Prompt / domain label shown in "cannot find" fallback message ---
CORPUS_LABEL=the ingested company filings
