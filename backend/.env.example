# --- LLM provider ---
# "groq"   -> free tier, no credit card, fast open-source models (RECOMMENDED, default)
# "ollama" -> fully local/offline, zero cost, needs Ollama installed on your machine
# "openai" -> paid, only if you have a funded OpenAI account
LLM_PROVIDER=groq

# Get a free key at https://console.groq.com/keys (no card required)
GROQ_API_KEY=gsk-your-key-here
GROQ_MODEL=llama-3.1-8b-instant

# Only needed if LLM_PROVIDER=ollama (install from https://ollama.com, then `ollama pull llama3.2`)
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# --- Embeddings (always free/local by default — no key needed) ---
# "huggingface"     -> runs the model locally (needs torch, ~500MB+ RAM —
#                       fine on your own machine, too heavy for free hosting tiers)
# "huggingface_api"  -> calls HuggingFace's free hosted Inference API instead
#                        (lightweight, no torch, RECOMMENDED for Render/free deploys)
# "openai"           -> paid, only if you have a funded OpenAI account
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Only needed if EMBEDDING_PROVIDER=huggingface_api — free token at https://huggingface.co/settings/tokens
HF_TOKEN=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Storage / data ---
CHROMA_PERSIST_DIR=./chroma_store
DATA_DIR=../data

# --- Prompt / domain label shown in "cannot find" fallback message ---
CORPUS_LABEL=the ingested company filings
